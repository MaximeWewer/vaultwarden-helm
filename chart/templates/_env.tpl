{{/* Vaultwarden container env. */}}
{{- define "vaultwarden.env" -}}
{{- $c := .Values.config -}}
{{- $secret := include "vaultwarden.secretName" . -}}
- name: DOMAIN
  value: {{ $c.domain | trimSuffix "/" | quote }}
- name: ROCKET_ADDRESS
  value: "0.0.0.0"
- name: ROCKET_PORT
  value: {{ .Values.containerPort | quote }}
- name: TZ
  value: {{ $c.timezone | quote }}
- name: DATA_FOLDER
  value: /data
# JWT signing key, shared by every pod (reads <RSA_KEY_FILENAME>.pem).
- name: RSA_KEY_FILENAME
  value: /etc/vaultwarden/rsa/rsa_key
{{- if eq .Values.storage.mode "s3" }}
# Shared objects in S3 (OpenDAL). /data is a per-pod emptyDir (tmp, icon cache).
- name: ATTACHMENTS_FOLDER
  value: {{ include "vaultwarden.s3.uri" (dict "root" . "folder" "attachments") | quote }}
- name: SENDS_FOLDER
  value: {{ include "vaultwarden.s3.uri" (dict "root" . "folder" "sends") | quote }}
{{- if .Values.storage.s3.configFileInBucket }}
- name: CONFIG_FILE
  value: {{ include "vaultwarden.s3.uri" (dict "root" . "folder" "config.json") | quote }}
{{- end }}
- name: AWS_ACCESS_KEY_ID
  valueFrom:
    secretKeyRef:
      name: {{ include "vaultwarden.s3.secretName" . }}
      key: {{ include "vaultwarden.s3.accessKeyKey" . }}
- name: AWS_SECRET_ACCESS_KEY
  valueFrom:
    secretKeyRef:
      name: {{ include "vaultwarden.s3.secretName" . }}
      key: {{ include "vaultwarden.s3.secretKeyKey" . }}
- name: AWS_REGION
  value: {{ .Values.storage.s3.region | quote }}
# No EC2 instance-metadata probing outside AWS.
- name: AWS_EC2_METADATA_DISABLED
  value: "true"
{{- end }}
{{- if eq .Values.database.type "cnpg" }}
- name: DATABASE_URL
  valueFrom:
    secretKeyRef:
      # Generated by the CloudNativePG operator for the application owner.
      name: {{ include "vaultwarden.cnpg.fullname" . }}-app
      key: uri
{{- else if eq .Values.database.type "external" }}
- name: DATABASE_URL
  valueFrom:
    secretKeyRef:
      {{- if .Values.externalDatabase.existingSecret }}
      name: {{ .Values.externalDatabase.existingSecret }}
      key: {{ .Values.externalDatabase.existingSecretKey }}
      {{- else }}
      name: {{ $secret }}
      key: database-url
      {{- end }}
{{- end }}
# Wait for the database forever at startup (the startupProbe bounds it).
- name: DB_CONNECTION_RETRIES
  value: "0"
- name: DATABASE_MAX_CONNS
  value: {{ $c.databaseMaxConns | quote }}
- name: ENABLE_WEBSOCKET
  value: "true"
- name: WEB_VAULT_ENABLED
  value: {{ $c.webVaultEnabled | quote }}
- name: SIGNUPS_ALLOWED
  value: {{ $c.signupsAllowed | quote }}
- name: SIGNUPS_VERIFY
  value: {{ $c.signupsVerify | quote }}
{{- with $c.signupsDomainsWhitelist }}
- name: SIGNUPS_DOMAINS_WHITELIST
  value: {{ . | quote }}
{{- end }}
- name: INVITATIONS_ALLOWED
  value: {{ $c.invitationsAllowed | quote }}
- name: INVITATION_ORG_NAME
  value: {{ $c.invitationOrgName | quote }}
- name: SHOW_PASSWORD_HINT
  value: {{ $c.showPasswordHint | quote }}
- name: PASSWORD_ITERATIONS
  value: {{ $c.passwordIterations | quote }}
- name: ORG_EVENTS_ENABLED
  value: {{ $c.orgEventsEnabled | quote }}
{{- with $c.eventsDaysRetain }}
- name: EVENTS_DAYS_RETAIN
  value: {{ . | quote }}
{{- end }}
- name: IP_HEADER
  value: {{ $c.ipHeader | quote }}
- name: LOG_LEVEL
  value: {{ $c.logLevel | quote }}
- name: EXTENDED_LOGGING
  value: {{ $c.extendedLogging | quote }}
{{- if $c.admin.enabled }}
- name: ADMIN_TOKEN
  valueFrom:
    secretKeyRef:
      name: {{ $secret }}
      key: admin-token
- name: ADMIN_RATELIMIT_SECONDS
  value: {{ $c.admin.ratelimitSeconds | quote }}
- name: ADMIN_RATELIMIT_MAX_BURST
  value: {{ $c.admin.ratelimitMaxBurst | quote }}
{{- end }}
{{- if $c.smtp.host }}
- name: SMTP_HOST
  value: {{ $c.smtp.host | quote }}
- name: SMTP_PORT
  value: {{ $c.smtp.port | quote }}
- name: SMTP_SECURITY
  value: {{ $c.smtp.security | quote }}
- name: SMTP_FROM
  value: {{ required "config.smtp.from is required with config.smtp.host" $c.smtp.from | quote }}
- name: SMTP_FROM_NAME
  value: {{ $c.smtp.fromName | quote }}
{{- with $c.smtp.username }}
- name: SMTP_USERNAME
  value: {{ . | quote }}
- name: SMTP_PASSWORD
  valueFrom:
    secretKeyRef:
      name: {{ $secret }}
      key: smtp-password
{{- end }}
{{- end }}
{{- if $c.push.enabled }}
- name: PUSH_ENABLED
  value: "true"
- name: PUSH_INSTALLATION_ID
  value: {{ $c.push.installationId | quote }}
- name: PUSH_INSTALLATION_KEY
  valueFrom:
    secretKeyRef:
      name: {{ $secret }}
      key: push-installation-key
- name: PUSH_RELAY_URI
  value: {{ $c.push.relayUri | quote }}
- name: PUSH_IDENTITY_URI
  value: {{ $c.push.identityUri | quote }}
{{- end }}
{{- if $c.sso.enabled }}
- name: SSO_ENABLED
  value: "true"
- name: SSO_ONLY
  value: {{ $c.sso.only | quote }}
- name: SSO_AUTHORITY
  value: {{ $c.sso.authority | quote }}
- name: SSO_CLIENT_ID
  value: {{ $c.sso.clientId | quote }}
- name: SSO_CLIENT_SECRET
  valueFrom:
    secretKeyRef:
      name: {{ $secret }}
      key: sso-client-secret
- name: SSO_SCOPES
  value: {{ $c.sso.scopes | quote }}
- name: SSO_PKCE
  value: {{ $c.sso.pkce | quote }}
- name: SSO_SIGNUPS_MATCH_EMAIL
  value: {{ $c.sso.signupsMatchEmail | quote }}
{{- end }}
{{- with $c.extraEnv }}
{{ toYaml . }}
{{- end }}
{{- end }}
